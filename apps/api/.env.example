ADDR=:8080
DATABASE_URL=postgres://adytus:adytus@localhost:5432/adytus?sslmode=disable

# 32 random bytes, base64. Generate with: head -c32 /dev/urandom | base64
SERVER_KEY=

# ollama (local mock) or openrouter
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
ALLOWED_MODELS=llama3.2

# OpenRouter example:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# ALLOWED_MODELS=vendor/model-a,vendor/model-b   (only models with ZDR providers)

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adytus
S3_ACCESS_KEY=adytus
S3_SECRET_KEY=adytus-secret
