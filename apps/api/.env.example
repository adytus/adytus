ADDR=:8080
DATABASE_URL=postgres://adytus:adytus@localhost:5432/adytus?sslmode=disable

# 32 random bytes, base64. Generate with: head -c32 /dev/urandom | base64
# Wraps keys of objects users opt into offline processing. Losing it only
# disables offline access; rotating it requires re-wrapping those keys.
SERVER_KEY=

# ollama (local stand-in, priced like OpenRouter) or openrouter
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
MODELS_FILE=models.ollama.json
SYSTEM_PROMPT="You are Adytus, a concise and helpful assistant."

# OpenRouter:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# MODELS_FILE=models.openrouter.json   (copy models.openrouter.example.json)

# Budgeting (micro-USD; 1 USD = 1000000)
DAILY_CAP_MICROS=2000000
HOLD_TTL=10m
CHAT_PER_MINUTE=20
AUTH_PER_MINUTE=10

SESSION_TTL=24h
SESSION_IDLE=2h
COOKIE_SECURE=false

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adytus
S3_ACCESS_KEY=adytus
S3_SECRET_KEY=adytus-secret
MAX_UPLOAD_BYTES=26214400

# Python sandbox: gVisor containers with numpy, scipy, Pillow, matplotlib.
# Needs docker with the runsc runtime and the image (see README).
# PYTHON_RUNTIME=runc runs it without gVisor; dev machines only.
PYTHON_ENABLED=true
PYTHON_RUNTIME=runsc
PYTHON_TIMEOUT=10s
PYTHON_MEMORY_MB=256
PYTHON_PARALLEL=2
# PYTHON_IMAGE=adytus-sandbox
# PYTHON_CPUS=1
# PYTHON_WARM=2
