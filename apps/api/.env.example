ADDR=:8080
DATABASE_URL=postgres://adytus:adytus@localhost:5432/adytus?sslmode=disable

# 32 random bytes, base64. Generate with: head -c32 /dev/urandom | base64
# Wraps keys of objects users opt into offline processing. Losing it only
# disables offline access; rotating it requires re-wrapping those keys.
SERVER_KEY=

# The LLM settings below and MODELS_FILE only seed the database on first
# start; after that they're edited in the backoffice.
# ollama (local stand-in, priced like OpenRouter), openrouter or nearai.
# LLM_BASE_URL may be left empty for the provider's usual endpoint.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
MODELS_FILE=models.ollama.json
SYSTEM_PROMPT="You are Adytus, a concise and helpful assistant."

# OpenRouter:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# MODELS_FILE=models.openrouter.json   (copy models.openrouter.example.json)

# NEAR AI Cloud (private inference in TEEs; key from cloud.near.ai):
# LLM_PROVIDER=nearai
# LLM_BASE_URL=https://cloud-api.near.ai/v1
# LLM_API_KEY=sk-...
# MODELS_FILE=models.nearai.json

# Budgeting (micro-USD internally; 1 token credit = 1000 micros, so $10 = 10,000 tokens)
DAILY_CAP_MICROS=2000000
HOLD_TTL=10m
CHAT_PER_MINUTE=20
AUTH_PER_MINUTE=10

SESSION_TTL=24h
SESSION_IDLE=2h
COOKIE_SECURE=false

# Crypto payments (USDC and ETH on Base). Off unless BASE_XPUB is set.
# BASE_XPUB is an extended PUBLIC key (xpub...), e.g. the m/44'/60'/0'/0
# account of a wallet whose keys stay offline. Each user gets one deposit
# address derived from it; the server cannot spend from them. Never put an
# xprv here: it is refused.
# BASE_RPC_URL=https://mainnet.base.org
# BASE_XPUB=
# BASE_CHAIN_ID=8453
# BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# BASE_ETH_USD_FEED=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70   (Chainlink; verify against chain docs)
# Base Sepolia: BASE_CHAIN_ID=84532, BASE_RPC_URL=https://sepolia.base.org,
#   BASE_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e,
#   BASE_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1
# CRYPTO_CONFIRMATIONS=12
# CRYPTO_QUOTE_TTL=15m
# CRYPTO_MIN_MICROS=5000000       smallest top-up the app offers ($5)
# CRYPTO_DUST_MICROS=100000       payments below this are not credited ($0.10)
# CRYPTO_ETH_TOLERANCE_BPS=100    an ETH payment up to 1% under its quote still gets the full amount
# CRYPTO_POLL=6s
# CRYPTO_FULL_SCAN=5m             how often addresses without a recent quote are checked for ETH

# Built backoffice UI, served to admins only.
BACKOFFICE_DIR=../backoffice/dist

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adytus
S3_ACCESS_KEY=adytus
S3_SECRET_KEY=adytus-secret
MAX_UPLOAD_BYTES=26214400

# Python sandbox: Pyodide under Deno, always on. Fetch Pyodide once with
# deploy/pyodide/fetch.ts (see README); these are optional tuning.
# PYODIDE_DIR=.pyodide
# PYTHON_TIMEOUT=30s
# PYTHON_MEMORY_MB=1024
# PYTHON_PARALLEL=2
# PYTHON_WARM=1

# Agent limits: tool rounds per reply, and wall clock for a whole reply.
# TOOL_MAX_STEPS=25
# REPLY_TIMEOUT=15m
